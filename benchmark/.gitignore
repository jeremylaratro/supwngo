# Built binaries, object files, and generated flag files are reproducible
# from committed C source (see build_all.sh) and are intentionally not
# committed -- only sources + the build recipe are checked in.
corpus/*/*
!corpus/*/*.c

# Round-2 held-out corpus: same rule (see build_all_r2.sh). R2 declares its
# per-target protection flags in a `cflags` file beside each source (rule R9 in
# benchmark/README.md), so that file is tracked alongside the .c.
corpus_r2/*/*
!corpus_r2/*/*.c
!corpus_r2/*/cflags
!corpus_r2/README.md

# Benchmark run output (timestamped) is generated, not committed. Everything
# under results/ is reproducible from the corpus + the harness. `results_*/`
# covers the per-round siblings (results_r2/, ...) that Corpus.results_root()
# derives from --corpus-root; without it a round-2 run's binaries, flag.txt
# secrets and reports become trackable.
results/*
results_*/

# run_bench.py's concurrency lock (see corpus_lock()) is runtime state.
corpus*/.run_bench.lock
