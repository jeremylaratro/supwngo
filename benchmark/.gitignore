# Built binaries, object files, and generated flag files are reproducible
# from committed C source (see build_all.sh) and are intentionally not
# committed -- only sources + the build recipe are checked in.
corpus/*/*
!corpus/*/*.c

# Round-2 held-out corpus: same rule (see build_all_r2.sh). R2 declares its
# per-target protection flags in a `cflags` file beside each source (rule R9 in
# benchmark/README.md), so that file is tracked alongside the .c.
corpus_r2/*/*
!corpus_r2/*/*.c
!corpus_r2/*/cflags
!corpus_r2/README.md

# Benchmark run output (timestamped) is generated, not committed. Everything
# under results/ is reproducible from the corpus + the harness. `results_*/`
# covers the per-round siblings (results_r2/, ...) that Corpus.results_root()
# derives from --corpus-root; without it a round-2 run's binaries, flag.txt
# secrets and reports become trackable.
results/*
results_*/

# run_bench.py's concurrency lock (see corpus_lock()) is runtime state.
corpus*/.run_bench.lock

# Container-overflow variant family: same rule again (built via
# SUPWNGO_BENCH_CORPUS=benchmark/corpus_variants benchmark/build_all.sh, which
# reaches these through its `cflags` fail-closed path). Sources + flags tracked,
# binaries and flag.txt not.
corpus_variants/*/*
!corpus_variants/*/*.c
!corpus_variants/*/cflags

# Signal-underflow variant family: same rule again (built via
# SUPWNGO_BENCH_CORPUS=benchmark/corpus_eintr benchmark/build_all.sh). Sources +
# flags tracked, binaries and flag.txt not.
corpus_eintr/*/*
!corpus_eintr/*/*.c
!corpus_eintr/*/cflags

# No-writable-segment SROP variant family: same rule again (built via
# SUPWNGO_BENCH_CORPUS=benchmark/corpus_srop benchmark/build_all.sh). Sources
# (.c/.S), cflags, and any linker script are tracked; binaries and flag.txt not.
corpus_srop/*/*
!corpus_srop/*/*.c
!corpus_srop/*/*.S
!corpus_srop/*/cflags
!corpus_srop/*/*.ld

# The remaining variant families opened by the 2026-09-27 capability run, all
# under the same rule (each built via its own SUPWNGO_BENCH_CORPUS=... run of
# build_all.sh, reaching these through the `cflags` fail-closed path):
#   corpus_scanf/        unbounded scanf/strtoull scalar overwrite
#   corpus_heap_variants/ glibc tcache/fastbin corruption
#   corpus_prng/         predictable pseudo-random secrets
corpus_scanf/*/*
!corpus_scanf/*/*.c
!corpus_scanf/*/cflags
corpus_heap_variants/*/*
!corpus_heap_variants/*/*.c
!corpus_heap_variants/*/cflags
corpus_prng/*/*
!corpus_prng/*/*.c
!corpus_prng/*/cflags

# Subprocess-injection variant family: same rule again. This one is the first
# non-memory-safety category in the set, but the artifact rule is unchanged --
# sources + cflags tracked, binaries and flag.txt not.
corpus_inject/*/*
!corpus_inject/*/*.c
!corpus_inject/*/cflags

# The two families opened from the 2026-09-27 HTB reversing outcome, same rule:
#   corpus_envpath/  sabotage's class -- unbounded heap write into a putenv'd
#                    environment string, finished through a relative system()
#   corpus_objptr/   auth-or-out's class merged with G-8b -- indirect-call hijack
#                    over a custom allocator whose size arithmetic wraps
corpus_envpath/*/*
!corpus_envpath/*/*.c
!corpus_envpath/*/cflags
corpus_objptr/*/*
!corpus_objptr/*/*.c
!corpus_objptr/*/cflags

# corpus_objptr_libc/ -- the SAME class with the destination removed from the
# image: no win function, no system@plt, so the hijacked pointer has to be
# aimed into libc. Needs its own three lines because a family name is not a
# prefix match: `corpus_objptr/*/*` does not cover `corpus_objptr_libc/`, and
# the corpus-wide flag.txt rule (.gitignore:269) covers only flag.txt. Measured
# before adding this, with `git add -n benchmark/corpus_objptr_libc`: **9
# compiled ELF images** were staged for commit while flag.txt was correctly
# ignored -- which is the failure mode this comment exists to stop repeating,
# because the ignored secret makes the whole block look like it is working.
corpus_objptr_libc/*/*
!corpus_objptr_libc/*/*.c
!corpus_objptr_libc/*/cflags

# corpus_bon/ -- bon-nie-appetit's class: a strlen()-derived length on a heap
# buffer that is never NUL-terminated. Same artifact rule: sources + cflags
# tracked, binaries and flag.txt not. Added when the family landed; before this
# rule existed `git check-ignore` reported the compiled binaries as NOT ignored
# while `flag.txt` already was (caught by .gitignore:269, the corpus-wide flag
# rule), so a path-scoped `git add benchmark/corpus_bon` would have committed
# four ELF images. The per-family binary rule is not redundant with the
# corpus-wide flag rule -- each family needs its own line.
corpus_bon/*/*
!corpus_bon/*/*.c
!corpus_bon/*/cflags

# TOCTOU file-race family: same rule again. This is the third non-memory-safety
# category in the set (after corpus_inject/ and corpus_prng/) and the artifact rule
# is unchanged -- sources + cflags tracked, binaries and flag.txt not. Worth being
# explicit about flag.txt here: in this family the flag file is not a fallback for
# a shell-obtaining target, it is THE object of the exploit (the target is raced
# into reading it and printing it), so committing it would publish the answer.
corpus_toctou/*/*
!corpus_toctou/*/*.c
!corpus_toctou/*/cflags

# corpus_uninit/ -- uninitialised-memory DISCLOSURE (CWE-457/CWE-908): a record
# is allocated, partially written, and handed back in full. Same artifact rule
# as every other family, and it needs its OWN three lines: the corpus-wide
# flag.txt rule does NOT cover compiled binaries, so without these a
# path-scoped `git add benchmark/corpus_uninit` would commit six ELF images.
# Verified with `git check-ignore` after the family was built: every ELF and
# flag.txt ignored, every .c and cflags NOT ignored.
corpus_uninit/*/*
!corpus_uninit/*/*.c
!corpus_uninit/*/cflags

# corpus_traversal/ -- PATH TRAVERSAL to arbitrary file read (CWE-22). Same artifact
# rule as every other family, and it needs its OWN three lines: a family name is not
# a prefix match and the corpus-wide flag.txt rule does NOT cover compiled binaries,
# so without these a path-scoped `git add benchmark/corpus_traversal` would commit
# six ELF images. flag.txt matters more here than in most families: in this category
# the flag file is not a fallback for a shell-obtaining target, it IS the object of
# the exploit (the target is made to read it and print it), so committing it would
# publish the answer AND leak a per-run secret.
corpus_traversal/*/*
!corpus_traversal/*/*.c
!corpus_traversal/*/cflags

# corpus_libhijack/ -- UNTRUSTED LIBRARY SEARCH PATH, dlopen/RUNPATH hijack
# (CWE-426/CWE-427). Same artifact rule as every other family, and it needs its
# OWN lines: a family name is not a prefix match and the corpus-wide flag.txt
# rule does NOT cover compiled binaries, so without these a path-scoped
# `git add benchmark/corpus_libhijack` would commit six ELF images.
#
# This family has THREE artifact kinds the others do not, and each needed a
# decision rather than a default:
#
#   * the family-level sources. `supwngo_ext.c` (the ONE legitimate extension
#     module, shared by every target) and `install_plugins.sh` (which compiles
#     and installs it) live at the family root, not in a target directory, so
#     `!corpus_libhijack/*/*.c` does not reach them. They are tracked
#     explicitly: without them the family cannot be rebuilt from the repo,
#     because `benchmark/build_all.sh` compiles exactly one artifact per target
#     directory and so cannot produce a second .so. See install_plugins.sh's
#     header for why that split exists.
#   * the installed plugins. `libsupwngoext.so.1` is a COMPILED artifact -- it
#     is reproduced by install_plugins.sh from the tracked source and must stay
#     ignored, in plugins/ and vendor/ alike. The `corpus_libhijack/*/*` rule
#     only covers one level down, so plugins/ and vendor/ get an explicit rule.
#   * libhj_13's EMPTY lib/ directory. git does not track empty directories at
#     all, so nothing here can express it -- which is a real gap and is called
#     out in corpus_libhijack.yaml: install_plugins.sh recreates it, and the
#     target's gate depends on it existing.
#
# flag.txt matters as much here as in corpus_toctou/ and corpus_traversal/: the
# proof of a win is a shell that then reads flag.txt, so committing it would
# both publish the answer and leak a per-run secret.
corpus_libhijack/*/*
corpus_libhijack/*/*/*
!corpus_libhijack/*/*.c
!corpus_libhijack/*/cflags
!corpus_libhijack/supwngo_ext.c
!corpus_libhijack/install_plugins.sh

# corpus_allocsize/ -- integer overflow in an ALLOCATION SIZE (CWE-190 ->
# CWE-122/787): the size handed to malloc/realloc is computed from an
# attacker-supplied count and the multiply or add WRAPS, so the chunk is tiny
# while the transfer length (computed independently, and never checked) still
# runs the full count. Same artifact rule as every other variation family:
# sources + cflags are tracked, the built ELFs and the per-run flag.txt are not.
corpus_allocsize/*/*
!corpus_allocsize/*/*.c
!corpus_allocsize/*/cflags

# corpus_finiarray/ -- hijacking a WRITABLE INITIALISER/FINALISER TABLE
# (CWE-787 against .fini_array / .init_array / a program-owned atexit-style
# handler table). Same artifact rule as every other family, and it needs its
# OWN three lines: a family name is not a prefix match and the corpus-wide
# flag.txt rule does NOT cover compiled binaries, so without these a
# path-scoped `git add benchmark/corpus_finiarray` would commit six ELF images.
#
# The `cflags` files matter more here than in most families and must stay
# TRACKED: RELRO is the entire discriminator of this category (four targets are
# linked `-z norelro`, two `-z relro -z now`), so a target that lost its cflags
# would be rebuilt at gcc's default -- PARTIAL RELRO -- which MEASURABLY makes
# `.fini_array` read-only and silently removes the target from the category.
#
# The proof of a win in this family is a SHELL (spawn_admin_shell -> system),
# from which the harness then reads flag.txt, so flag.txt is a per-run secret
# and stays ignored like every other family's.
corpus_finiarray/*/*
!corpus_finiarray/*/*.c
!corpus_finiarray/*/cflags

# corpus_offbyone/ -- OFF-BY-ONE / SINGLE-BYTE OVERFLOW (CWE-193 / CWE-787): a
# fill whose bound is N writes at index N, and the exploit is decided by WHAT the
# extra byte lands on (a saved frame pointer, a length guard, a saved pointer, a
# guard word). Same artifact rule as every other family, and it needs its OWN
# three lines: the corpus-wide flag.txt rule does NOT cover compiled binaries, so
# without these a path-scoped `git add benchmark/corpus_offbyone` would commit six
# ELF images. Verified with `git check-ignore` after the family was built: every
# ELF and flag.txt ignored, every .c and cflags NOT ignored.
corpus_offbyone/*/*
!corpus_offbyone/*/*.c
!corpus_offbyone/*/cflags

# corpus_typeconf/ -- TYPE CONFUSION THROUGH AN ATTACKER-CONTROLLED UNION TAG
# (CWE-843): a record holds a union plus a separate `tag` field naming which arm
# is live, and the tag can be made to say "code pointer" over eight bytes that
# were written as an integer. Same artifact rule as every other variation
# family, and it needs its OWN three lines: a family name is not a prefix match
# and the corpus-wide flag.txt rule does NOT cover compiled binaries, so without
# these a path-scoped `git add benchmark/corpus_typeconf` would commit six ELF
# images. Verified with `git check-ignore` after the family was built.
#
# The `cflags` files must stay TRACKED for a reason specific to this family:
# `-O0` is load-bearing, not stylistic. At higher -O gcc may keep the union in a
# register across the store/reload or devirtualise `c->u.fn()` into a direct
# call, and either one MEASURABLY removes the target from the category. A target
# rebuilt without its cflags would be a different challenge wearing this name.
#
# The proof of a win here is a SHELL (win() -> system("/bin/sh")), from which the
# harness then reads flag.txt, so flag.txt is a per-run secret and stays ignored
# like every other family's.
corpus_typeconf/*/*
!corpus_typeconf/*/*.c
!corpus_typeconf/*/cflags

# corpus_uafread/ -- HEAP USE-AFTER-FREE USED TO **READ** (CWE-416 -> CWE-200): a
# record is released and then read again, and the program writes bytes it has
# already handed back to the allocator straight to stdout. Same artifact rule as
# every other variation family, and it needs its OWN three lines: a family name is
# not a prefix match and the corpus-wide flag.txt rule does NOT cover compiled
# binaries, so without these a path-scoped `git add benchmark/corpus_uafread`
# would commit six ELF images. Verified with `git check-ignore` after the family
# was built.
#
# flag.txt matters here as much as in corpus_traversal/ and corpus_toctou/, and
# for the same reason: in this category the flag file is not a fallback for a
# shell-obtaining target, it IS the object of the exploit. The success signal for
# the whole family is FLAG_CAPTURED -- the target is made to read freed memory and
# print the secret out of it -- so committing flag.txt would publish the answer
# AND leak a per-run secret.
#
# The `cflags` files must stay TRACKED for a reason specific to this family: `-O0`
# is load-bearing three times over, not stylistic. At higher -O the record layout
# (the fd/bk window at +0/+8 and the secret at +32) may move, the control's
# `memset(...); free(...)` pair may stop being two adjacent CALLS -- which is the
# executor's static discriminator against the control -- and uafr_12's `malloc`
# may be rewritten into the `calloc` the control uses. A target rebuilt without
# its cflags would be a different challenge wearing this name.
corpus_uafread/*/*
!corpus_uafread/*/*.c
!corpus_uafread/*/cflags
!corpus_uafread/corpus_uafread.yaml
