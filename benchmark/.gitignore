# Built binaries, object files, and generated flag files are reproducible
# from committed C source (see build_all.sh) and are intentionally not
# committed -- only sources + the build recipe are checked in.
corpus/*/*
!corpus/*/*.c

# Round-2 held-out corpus: same rule (see build_all_r2.sh). R2 declares its
# per-target protection flags in a `cflags` file beside each source (rule R9 in
# benchmark/README.md), so that file is tracked alongside the .c.
corpus_r2/*/*
!corpus_r2/*/*.c
!corpus_r2/*/cflags
!corpus_r2/README.md

# Benchmark run output (timestamped) is generated, not committed. Everything
# under results/ is reproducible from the corpus + the harness. `results_*/`
# covers the per-round siblings (results_r2/, ...) that Corpus.results_root()
# derives from --corpus-root; without it a round-2 run's binaries, flag.txt
# secrets and reports become trackable.
results/*
results_*/

# run_bench.py's concurrency lock (see corpus_lock()) is runtime state.
corpus*/.run_bench.lock

# Container-overflow variant family: same rule again (built via
# SUPWNGO_BENCH_CORPUS=benchmark/corpus_variants benchmark/build_all.sh, which
# reaches these through its `cflags` fail-closed path). Sources + flags tracked,
# binaries and flag.txt not.
corpus_variants/*/*
!corpus_variants/*/*.c
!corpus_variants/*/cflags

# Signal-underflow variant family: same rule again (built via
# SUPWNGO_BENCH_CORPUS=benchmark/corpus_eintr benchmark/build_all.sh). Sources +
# flags tracked, binaries and flag.txt not.
corpus_eintr/*/*
!corpus_eintr/*/*.c
!corpus_eintr/*/cflags

# No-writable-segment SROP variant family: same rule again (built via
# SUPWNGO_BENCH_CORPUS=benchmark/corpus_srop benchmark/build_all.sh). Sources
# (.c/.S), cflags, and any linker script are tracked; binaries and flag.txt not.
corpus_srop/*/*
!corpus_srop/*/*.c
!corpus_srop/*/*.S
!corpus_srop/*/cflags
!corpus_srop/*/*.ld

# The remaining variant families opened by the 2026-09-27 capability run, all
# under the same rule (each built via its own SUPWNGO_BENCH_CORPUS=... run of
# build_all.sh, reaching these through the `cflags` fail-closed path):
#   corpus_scanf/        unbounded scanf/strtoull scalar overwrite
#   corpus_heap_variants/ glibc tcache/fastbin corruption
#   corpus_prng/         predictable pseudo-random secrets
corpus_scanf/*/*
!corpus_scanf/*/*.c
!corpus_scanf/*/cflags
corpus_heap_variants/*/*
!corpus_heap_variants/*/*.c
!corpus_heap_variants/*/cflags
corpus_prng/*/*
!corpus_prng/*/*.c
!corpus_prng/*/cflags

# Subprocess-injection variant family: same rule again. This one is the first
# non-memory-safety category in the set, but the artifact rule is unchanged --
# sources + cflags tracked, binaries and flag.txt not.
corpus_inject/*/*
!corpus_inject/*/*.c
!corpus_inject/*/cflags

# The two families opened from the 2026-09-27 HTB reversing outcome, same rule:
#   corpus_envpath/  sabotage's class -- unbounded heap write into a putenv'd
#                    environment string, finished through a relative system()
#   corpus_objptr/   auth-or-out's class merged with G-8b -- indirect-call hijack
#                    over a custom allocator whose size arithmetic wraps
corpus_envpath/*/*
!corpus_envpath/*/*.c
!corpus_envpath/*/cflags
corpus_objptr/*/*
!corpus_objptr/*/*.c
!corpus_objptr/*/cflags

# corpus_bon/ -- bon-nie-appetit's class: a strlen()-derived length on a heap
# buffer that is never NUL-terminated. Same artifact rule: sources + cflags
# tracked, binaries and flag.txt not. Added when the family landed; before this
# rule existed `git check-ignore` reported the compiled binaries as NOT ignored
# while `flag.txt` already was (caught by .gitignore:269, the corpus-wide flag
# rule), so a path-scoped `git add benchmark/corpus_bon` would have committed
# four ELF images. The per-family binary rule is not redundant with the
# corpus-wide flag rule -- each family needs its own line.
corpus_bon/*/*
!corpus_bon/*/*.c
!corpus_bon/*/cflags

# TOCTOU file-race family: same rule again. This is the third non-memory-safety
# category in the set (after corpus_inject/ and corpus_prng/) and the artifact rule
# is unchanged -- sources + cflags tracked, binaries and flag.txt not. Worth being
# explicit about flag.txt here: in this family the flag file is not a fallback for
# a shell-obtaining target, it is THE object of the exploit (the target is raced
# into reading it and printing it), so committing it would publish the answer.
corpus_toctou/*/*
!corpus_toctou/*/*.c
!corpus_toctou/*/cflags
